with "aws";
with "gnatcoll";
with "gtkada";

project OZE is

   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";

   for Main use ("main.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022",
         "-g",
         "-O0",
         "-gnatwa");
   end Compiler;

   package Linker is
      for Switches ("Ada") use
        (OZE'Project_Dir & "assets/ozecalc_resources.o",
         "-lgio-2.0",
         "-lgobject-2.0",
         "-lglib-2.0");
   end Linker;

end OZE;
